def extract_images_from_hwp_document(hwp_path: str, output_dir: str) -> None:
    """HWP 문서에서 모든 이미지를 추출하여 지정된 디렉토리에 저장합니다.
    
    Args:
        hwp_path: HWP 문서 경로
        output_dir: 이미지 저장 디렉토리
    """
    # 1. 경로 정규화
    hwp_path = normalize_path(hwp_path)
    output_dir = normalize_path(output_dir)
    
    # 2. 이미지 추출
    try:
        # 이미지 추출 (반환값: 저장된 이미지 파일 경로 목록)
        image_paths = extract_images_from_hwp(hwp_path, output_dir)
        
        if not image_paths:
            print("[WARNING] 추출된 이미지가 없습니다.")
            return
        
        # 3. 결과 출력
        print(f"[INFO] 총 {len(image_paths)}개의 이미지 추출 완료")
        for path in image_paths:
            print(f"[INFO] 이미지 저장: {path}")
        
        print("[SUCCESS] 모든 이미지 추출 완료")
    
    except Exception as e:
        print(f"[ERROR] 이미지 추출 실패: {str(e)}")
        raise