### 3.4 웹 검색 및 모니터링 도구
1. 웹 검색 예시:
   ```python
   # 1. 웹 검색 실행
   results = search_web(
       query="검색어",
       site="youtube",  # youtube, naver, google, daum 중 선택
       max_results=5  # 최대 검색 결과 수
   )
   
   # 2. 검색 결과 처리
   for result in results:
       print(f"[INFO] 제목: {result['title']}")
       print(f"[INFO] URL: {result['url']}")
       print(f"[INFO] 설명: {result['description']}")
   
   # 3. 검색 결과 열기 (첫 번째 결과)
   if results:
       success = open_search_result(results)  # 기본값: index=0
       if success:
           print("[SUCCESS] 브라우저에서 열기 성공")
       else:
           print("[ERROR] 브라우저에서 열기 실패")
   ```

2. 검색 결과 열기:
   ```python
   # 특정 인덱스의 결과 열기
   success = open_search_result(results, index=2)  # 세 번째 결과 열기
   ```

3. 콘텐츠 분석 도구
   ```python
   def analyze_content(content: dict) -> dict:
       """웹 콘텐츠 분석
       Args:
           content: 추출된 웹 콘텐츠
       Returns:
           분석 결과
       """
       try:
           # 1. 텍스트 정제
           text = content.get("text", "").strip()
           if not text:
               return {}
           
           # 2. 텍스트 요약
           processor = TextProcessor()
           summary = processor.summarize(text)
           
           # 3. 키워드 추출
           keywords = processor.extract_keywords(text)
           
           # 4. 감성 분석
           sentiment = processor.analyze_sentiment(text)
           
           return {
               "title": content.get("title", ""),
               "url": content.get("url", ""),
               "summary": summary,
               "keywords": keywords,
               "sentiment": sentiment
           }
           
       except Exception as e:
           print(f"[ERROR] 콘텐츠 분석 실패: {str(e)}")
           return {}
   ```

4. 보고서 생성 도구
   ```python
   def generate_report(analysis: dict) -> str:
       """분석 결과 보고서 생성
       Args:
           analysis: 분석 결과
       Returns:
           보고서 파일 경로
       """
       try:
           # 1. PDF 문서 생성
           doc = PDFDocument()
           
           # 2. 제목 추가
           doc.add_title("웹 콘텐츠 분석 보고서")
           doc.add_subtitle(f"생성일시: {datetime.now().strftime('%Y-%m-%d %H:%M')}")
           
           # 3. 분석 결과 추가
           doc.add_heading("1. 개요")
           doc.add_paragraph(f"제목: {analysis['title']}")
           doc.add_paragraph(f"URL: {analysis['url']}")
           
           doc.add_heading("2. 요약")
           doc.add_paragraph(analysis['summary'])
           
           doc.add_heading("3. 주요 키워드")
           for keyword in analysis['keywords']:
               doc.add_paragraph(f"- {keyword}")
           
           doc.add_heading("4. 감성 분석")
           doc.add_paragraph(f"긍정/부정: {analysis['sentiment']}")
           
           # 4. 저장
           output_path = safe_path_join("output", "web_analysis.pdf")
           doc.save(output_path)
           print(f"[SUCCESS] 보고서 생성 완료: {output_path}")
           
           return output_path
           
       except Exception as e:
           print(f"[ERROR] 보고서 생성 실패: {str(e)}")
           raise
   ```

5. 알림 발송 도구
   ```python
   def send_alert(analysis: dict, report_path: str) -> None:
       """분석 결과 알림 발송
       Args:
           analysis: 분석 결과
           report_path: 보고서 파일 경로
       """
       try:
           subject = f"[알림] 새로운 콘텐츠 발견: {analysis['title']}"
           body = f"""
           새로운 웹 콘텐츠가 발견되었습니다.
           
           제목: {analysis['title']}
           URL: {analysis['url']}
           
           요약:
           {analysis['summary']}
           
           주요 키워드:
           {', '.join(analysis['keywords'])}
           
           자세한 내용은 첨부된 보고서를 참고하세요.
           """
           
           send_email(
               to_email="chaeya@gmail.com",
               subject=subject,
               body=body,
               attachments=[report_path]
           )
           print("[SUCCESS] 알림 발송 완료")
           
       except Exception as e:
           print(f"[ERROR] 알림 발송 실패: {str(e)}")
           raise
   ```

6. 주의사항
   - 검색 요청 간격 조절 (과도한 요청 방지)
   - 웹사이트 robots.txt 준수
   - 콘텐츠 저작권 고려
   - 알림 중복 발송 방지
   - 네트워크 오류 처리
   - 메모리 사용량 관리

### 3.5 시각화 도구
1. Matplotlib 사용
   ```python
   # 1. 기본 그래프 생성
   fig, ax, font_prop = create_matplotlib(figsize=(10, 6))
   
   # 2. 그래프 그리기
   ax.plot(x, y, label='데이터')
   
   # 3. 텍스트 설정 (반드시 font_prop 사용)
   ax.set_title("제목", fontproperties=font_prop)
   ax.set_xlabel("X축", fontproperties=font_prop)
   ax.set_ylabel("Y축", fontproperties=font_prop)
   ax.legend(prop=font_prop)
   
   # 4. 그래프 저장
   save_plot(fig, "output.png", dpi=300)
   ```

2. 그래프 종류별 예시:
   ```python
   # 선 그래프
   ax.plot(x, y, marker='o', label='데이터')
   ax.legend(prop=font_prop)
   
   # 막대 그래프
   ax.bar(x, y)
   
   # 파이 차트
   ax.pie(values, labels=labels, autopct='%1.1f%%')
   ax.axis('equal')
   ```

3. 주의사항:
   - 모든 텍스트에 font_prop 사용 필수
   - 그래프 저장 시 항상 save_plot() 함수 사용
   - 범례가 필요한 경우 반드시 font_prop 적용
   - 한글 폰트 자동 처리됨

