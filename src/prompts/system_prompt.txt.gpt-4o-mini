### 3.3 AI 및 텍스트 처리 도구
1. TextProcessor 클래스
   ```python
   # 1. 객체 생성
   processor = TextProcessor()
   
   # 2. 텍스트 요약
   summary = processor.summarize(text, max_length=200)

   # 3. 텍스트 번역
   translated = processor.translate(text, "en")

   # 4. 텍스트 분석
   def analyze_text(text: str) -> dict:
       """텍스트 분석
       Args:
           text: 분석할 텍스트
       Returns:
           분석 결과 딕셔너리
       """
       try:
           # 1. 텍스트 전처리
           text = text.strip()
           if not text:
               return {}
           
           # 2. 텍스트 요약
           processor = TextProcessor()
           summary = processor.summarize(text, max_length=200)
           
           # 3. 패턴 매칭
           patterns = {
               '날짜': r'\d{4}[-\.년]\s*\d{1,2}[-\.월]\s*\d{1,2}[일]?',
               '금액': r'금액|원|계약금',
               '기간': r'기간|계약기간|유효기간',
               '의무': r'의무|책임|해야\s*한다',
               '위험': r'위험|손해|배상|해지|해제'
           }
           
           matches = {}
           for key, pattern in patterns.items():
               matches[key] = find_pattern(text, pattern)
           
           # 4. 결과 반환
           return {
               'summary': summary,
               'matches': matches
           }
           
       except Exception as e:
           print("[ERROR] 텍스트 분석 실패: %s" % str(e))
           return {}
   
   # 5. 패턴 매칭 함수
   def find_pattern(text: str, pattern: str) -> list:
       """패턴 매칭
       Args:
           text: 검색할 텍스트
           pattern: 정규식 패턴
       Returns:
           매칭된 문자열 리스트
       """
       try:
           import re
           matches = re.finditer(pattern, text, re.MULTILINE)
           results = []
           
           for match in matches:
               # 매칭된 문장 추출 (앞뒤 50자)
               start = max(0, match.start() - 50)
               end = min(len(text), match.end() + 50)
               sentence = text[start:end].strip()
               results.append(sentence)
           
           return results
           
       except Exception as e:
           print("[ERROR] 패턴 매칭 실패: %s" % str(e))
           return []
   ```

2. 문서 분석 예시:
   ```python
   # 1. 문서 읽기
   text = extract_from_hwp(hwp_path)
   
   # 2. 텍스트 분석
   result = analyze_text(text)
   
   # 3. 결과 처리
   if result:
       summary = result['summary']
       dates = result['matches']['날짜']
       amounts = result['matches']['금액']
       periods = result['matches']['기간']
       obligations = result['matches']['의무']
       risks = result['matches']['위험']
   ```

3. 파일 처리 예시:
   ```python
   # 1. 출력 디렉토리 생성
   output_dir = normalize_path("output")
   if not os.path.exists(output_dir):
       os.makedirs(output_dir)
   
   # 2. 파일 읽기
   try:
       if file.endswith(('.hwp', '.hwpx')):
           text = extract_from_hwp(file_path)
       elif file.endswith('.pdf'):
           text = extract_from_pdf(file_path)
       else:
           text = read_file(file_path)
   except Exception as e:
       print("[ERROR] 파일 읽기 실패: %s" % str(e))
       return None
   ```

